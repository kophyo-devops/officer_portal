# Amazon Cognito (User Pool)
VITE_AWS_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# After `sam deploy`, paste ApiBaseUrl here (no trailing slash)
# Example: https://abc123.execute-api.ap-southeast-1.amazonaws.com
VITE_API_BASE_URL=

# Do NOT put S3 access keys here.
# S3 is used only via API Gateway + Lambda presigned URLs.
